# Database Configuration
# In production, specify your PostgreSQL connection string:
# POSTGRES_URL=postgresql://user:password@localhost:5432/ecommerce_analytics
# If unset or if PostgreSQL is unreachable, the system automatically uses the embedded SQLite database (data/processed/ecommerce.db) for demo/local mode.
DB_DIALECT=sqlite
DB_PATH=data/processed/ecommerce.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_analytics

# Application Mode
APP_ENV=development
RANDOM_SEED=42
